# Images for docker-compose.local.yml. Use local builds, or the ECR images
# pulled before tearing the AWS stack down, e.g.:
#   <account>.dkr.ecr.<region>.amazonaws.com/unitree-sim:isaac-5.0
IMAGE_SIM=unitree-sim:local
IMAGE_MONTY=monty:local
IMAGE_GLUE=glue-base:local

# Simulation timestep (seconds) and WebRTC viewport toggle
DT=0.02
WEBRTC=0

# Optional path/URI of a brain checkpoint to load (empty = fresh brain)
CHECKPOINT_IN=
